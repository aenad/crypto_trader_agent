# MCP server connection. Configure the transport and endpoint from your MCP provider.
QUANTPILOT_MODE=SHADOW
QUANTPILOT_LIVE_EXECUTION_ENABLED=false
# Phase 2 CLI reads process environment only; no .env/account keys are needed.
QUANTPILOT_POSTGRES_DSN=
QUANTPILOT_DB_PASSWORD=
MCP_TRANSPORT=streamable_http
MCP_URL=https://api.wallex.ir/mcp
MCP_COMMAND=
MCP_ARGS=[]
MCP_ENV_JSON={}

# Optional bearer token for an HTTP MCP server. Keep secrets out of source control.
MCP_BEARER_TOKEN=

# Wallex private tools use X-API-Key. Public tools do not require a key.
WALLEX_API_KEY=

# Comma-separated MCP tool names, if you know them. Empty values enable discovery.
MCP_TOOLS_MARKETS=
MCP_TOOLS_TICKER=
MCP_TOOLS_CANDLES=
MCP_TOOLS_BALANCE=
MCP_TOOLS_ORDERS=

# The app serves recommendations only until trading is explicitly configured.
TRADING_MODE=shadow
MEMORY_DB_PATH=data/agent_memory.sqlite3
GRAPH_DB_PATH=data/agent_checkpoints.sqlite3
LIVE_TRADING_ENABLED=false
MAX_ORDER_QUOTE=250000
MAX_DAILY_LOSS=150000
RISK_PER_TRADE=0.005

# QuantPilot LLM Analyst - dedicated credentials, never use the Wallex API key.
# TOKEN: LLM-only token. GATEWAY: approved HTTPS gateway URL (not a guessed vendor URL).
# MODEL_ID: exact model identifier supplied by your LLM provider.
# Gateway contract: POST {model, request, response_schema}; response {output: JSON string}.
# SHADOW start reads only these LLM keys: process environment > .env > SHADOW JSON.
# Mapped SHADOW JSON fields: llm_gateway, analyst_model_id,
# llm_timeout_seconds and llm_call_budget. Token is never stored in the JSON config.
# Real calls additionally require QUANT_ML_LLM, a frozen ML artifact and --allow-llm-network.
# Adding this block does not enable LLM calls or LIVE trading.
QUANTPILOT_LLM_TOKEN=
QUANTPILOT_LLM_GATEWAY=
QUANTPILOT_LLM_MODEL_ID=
QUANTPILOT_LLM_TIMEOUT_SECONDS=10
QUANTPILOT_LLM_CALL_BUDGET=100
WALLEX_API_BASE=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/connection/websocket
WALLEX_MCP_URL=https://api.wallex.ir/mcp
WALLEX_SUB_ACCOUNT_CLIENT_ID=

# WALLEX_MCP_URL is the canonical name; MCP_URL remains a legacy alias.
# WALLEX_API_KEY must be created for the intended account; never substitute an LLM token.
# WALLEX_SUB_ACCOUNT_CLIENT_ID is private local account context, not a trading grant.
# Credit probe sends the selector only with --sub-account-context.
# Header forwarding by MCP and order-key ownership are not established by balance equality.

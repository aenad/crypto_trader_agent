# MCP server connection. Configure the transport and endpoint from your MCP provider.
MCP_TRANSPORT=streamable_http
MCP_URL=https://api.wallex.ir/mcp
MCP_COMMAND=
MCP_ARGS=[]
MCP_ENV_JSON={}

# Optional bearer token for an HTTP MCP server. Keep secrets out of source control.
MCP_BEARER_TOKEN=

# Wallex private tools use X-API-Key. Public tools do not require a key.
WALLEX_API_KEY=

# Comma-separated MCP tool names, if you know them. Empty values enable discovery.
MCP_TOOLS_MARKETS=
MCP_TOOLS_TICKER=
MCP_TOOLS_CANDLES=
MCP_TOOLS_BALANCE=
MCP_TOOLS_ORDERS=

# The app serves recommendations only until trading is explicitly configured.
TRADING_MODE=shadow
MEMORY_DB_PATH=data/agent_memory.sqlite3
GRAPH_DB_PATH=data/agent_checkpoints.sqlite3
LIVE_TRADING_ENABLED=false
MAX_ORDER_QUOTE=250000
MAX_DAILY_LOSS=150000
RISK_PER_TRADE=0.005

FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src/quantpilot ./src/quantpilot
RUN pip install --no-cache-dir '.[marketdata]'
COPY config/shadow.deploy.json /app/config/shadow.deploy.json
RUN mkdir -p /app/data && chown 65534:65534 /app/data
USER 65534:65534
CMD ["python", "-m", "quantpilot.shadow.cli", "start", "--config", "/app/config/shadow.deploy.json", "--db", "/app/data/session.sqlite", "--responses", "/app/data/responses", "--no-env-file"]
